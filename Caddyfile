# Caddy gateway for z620-a4000-srv.
#
# Unauthenticated — relies on the box being VPN-only / restricted-network.
# Add basicauth / API-key / IdP if that ever stops being true (see dgx-spark-srv
# Caddyfile git history for re-add patterns).

{
	# Suppress the admin warning; we don't expose it.
	admin off
	# Auto-HTTPS still issues certs for the HTTPS site, but must NOT inject
	# HTTP→HTTPS redirects: they land on port 80 AHEAD of our `:80` block, so
	# any request with Host == SITE_HOST got 308'd to HTTPS instead of reaching
	# the plain-HTTP routes (the whole point of the `:80` block).
	auto_https disable_redirects
	# Default file storage paths for /data and /config live in the volumes.
}

# Named path matchers — used by both site blocks below.
# TEI listens at bare /embed and /rerank, so we match both the bare path and
# any subpaths, and use `handle` (not `handle_path`) to preserve the prefix.
# `handle` shorthand only accepts ONE path argument, so multi-path matching
# requires a named matcher.
(tei_routes) {
	@tei_embed   path /embed /embed/*
	@tei_rerank  path /rerank /rerank/*

	handle @tei_embed {
		# TEI's health route lives at the root; map the gateway path onto it
		# (health.sh probes /embed/health).
		rewrite /embed/health /health
		reverse_proxy tei:80
	}
	handle @tei_rerank {
		rewrite /rerank/health /health
		reverse_proxy tei-reranker:80
	}

	# OpenAI-compatible clients: /tei/v1/embeddings → TEI /v1/embeddings
	# ({"model","input":[...]} → {"data":[{"index","embedding"}]}).
	# handle_path strips /tei, exposing TEI's whole native surface under the
	# prefix (/tei/embed, /tei/health, ... also work). Can't live under /v1 —
	# that belongs to vLLM in both site blocks.
	handle_path /tei/* {
		reverse_proxy tei:80
	}
}

# Grafana (Claude Code usage dashboards) — served by the STANDALONE
# claude-usage/ stack (own compose project, own network), reached via its
# host port. Caddy resolves host.docker.internal through the `extra_hosts`
# entry in compose.gateway.yml. claude-usage/.env must set
# GRAFANA_ROOT_URL=https://<SITE_HOST>/grafana/ and GRAFANA_SUB_PATH=true.
# Returns 502 (not a crash) if that stack isn't running.
(grafana_route) {
	redir /grafana /grafana/ 308
	handle /grafana/* {
		reverse_proxy host.docker.internal:3000
	}
}

# HTTPS site — primary endpoint.
{$SITE_HOST}{$SITE_ADDRESSES} {
	tls {$TLS_MODE}

	# OpenAI-compatible chat / completions / embeddings (vLLM).
	# `handle` (not `handle_path`) — vLLM serves at /v1/*, so preserve the prefix.
	handle /v1/* {
		reverse_proxy vllm:8000
	}

	# Ollama API
	handle_path /ollama/* {
		reverse_proxy ollama:11434
	}

	# TEI (embed + rerank) — see (tei_routes) snippet above.
	import tei_routes
	import grafana_route

	# Status dashboard — static HTML.
	redir /health-status /health-status/ 308
	handle_path /health-status/* {
		root * /data/status
		file_server
	}

	# Anything else: 404
	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}

# Plain HTTP for cert-averse clients (Ollama CLI, scripts that can't pin a
# self-signed CA). `:80` matches ANY Host header on port 80 — so clients can
# reach these routes by hostname, IP, or localhost without TLS or Host-header
# fiddling. Same routing semantics as the HTTPS block:
#   - `handle` preserves the prefix (vLLM /v1; TEI bare /embed, /rerank).
#   - `handle_path` strips the prefix (Ollama API is at /api/*).
# Unmatched paths 404 (NOT a redirect to HTTPS — for IP-Host clients the
# HTTPS redirect would just fail at the TLS handshake; better to 404 cleanly).
:80 {
	handle /v1/* {
		reverse_proxy vllm:8000
	}
	handle_path /ollama/* {
		reverse_proxy ollama:11434
	}
	import tei_routes
	import grafana_route

	# Status dashboard — static HTML.
	redir /health-status /health-status/ 308
	handle_path /health-status/* {
		root * /data/status
		file_server
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
