# claude-usage — copy to .env and edit. `make up` reads it.

# Grafana admin password (needed only to EDIT dashboards; viewing is anonymous
# unless GRAFANA_ANON_VIEW=false).
GRAFANA_PASSWORD=change-me
GRAFANA_ANON_VIEW=true

# Where Grafana is reached. Standalone: leave defaults (http://<host>:3000/).
# Behind a reverse proxy at a sub-path (e.g. z620 Caddy /grafana/):
#   GRAFANA_ROOT_URL=https://z620-a4000.local/grafana/
#   GRAFANA_SUB_PATH=true
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SUB_PATH=false
GRAFANA_PORT=3000

# Collector listen ports on the host (what managed-settings.json points at).
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# Prometheus retention. Series count is tiny (users × models × types), so
# months are cheap.
PROM_RETENTION=180d

# Durable data (Prometheus TSDB + Grafana state). Relative to this directory
# or absolute. Created by `make init`, owned by you — containers run as PUID/PGID.
DATA_ROOT=./data
# Filled automatically by `make` from `id -u` / `id -g`; set explicitly if you
# run docker compose by hand.
#PUID=1000
#PGID=1000
