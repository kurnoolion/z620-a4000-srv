# =============================================================================
# z620-a4000-srv — environment configuration
#
# Copy to `.env` and edit, then `chmod 600 .env`. Never commit secrets.
#
# Box: HP Z620 · 24 GB RAM · NVIDIA RTX A4000 16 GB · 250 GB SSD + 1 TB HDD
# Arch: x86_64 · CUDA 12.x · sm_86 (Ampere)
# =============================================================================

# ----- Host / gateway -----------------------------------------------------
# Hostname that clients use (NOT an IP — see README "Reaching the stack").
# Add `<box-ip>  z620-a4000.local` to each client's /etc/hosts.
SITE_HOST=z620-a4000.local

# Optional extra SANs (comma-separated hostnames). Don't put IPs here.
# SITE_ADDRESSES=

# `tls internal` issues a self-signed cert via Caddy's internal CA.
# Swap for ACME / corp PKI when leaving the trust boundary.
TLS_MODE=internal

# ----- Storage roots ------------------------------------------------------
# Active (SSD): hot models you load right now + service state.
ACTIVE_ROOT=/data/active
# Archive (HDD): HF cache + downloaded model storage + backups.
ARCHIVE_ROOT=/archive

# ----- vLLM ---------------------------------------------------------------
# Model to serve. Three valid forms (auto-resolved):
#   * Bare name        e.g. Qwen2.5-7B-Instruct-AWQ → looked up under
#                         $ARCHIVE_ROOT/models/local/<name>, then $ACTIVE_ROOT/models/local/<name>
#   * Absolute path    e.g. /data/active/models/local/Qwen2.5-7B-Instruct-AWQ
#   * HF repo ID       e.g. Qwen/Qwen2.5-7B-Instruct-AWQ — read from HF cache
VLLM_MODEL=Qwen2.5-7B-Instruct-AWQ

# vLLM image. v0.6+ supports sm_86 (Ampere) AWQ natively on CUDA 12.x.
VLLM_IMAGE=vllm/vllm-openai:v0.6.3

# Fraction of the 16 GB VRAM vLLM pre-allocates. vLLM is TIME-SHARED with kev
# (compose profiles enforce mutual exclusion) and GPU TEI is always on, so
# this slice must leave ~5-6 GB for TEI. 0.55 (= 8.8 GB) works at native 32K.
#   0.55 → vLLM at native 32K context, room for GPU TEI alongside. DEFAULT.
#   0.80 → vLLM-only (make llm-stop; then make up llm=vllm with GPU TEI off).
#   0.90 → vLLM at 128K YaRN; incompatible with GPU TEI on 16 GB card.
VLLM_GPU_UTIL=0.55

# Max context length the served model advertises. At VLLM_GPU_UTIL=0.55 with
# GPU TEI alongside, 131072 YaRN won't fit — stay native 32K here.
VLLM_MAX_MODEL_LEN=32768

# RoPE scaling. Blank = model's native context (recommended with the default
# 0.55 util + GPU TEI setup). For 128K YaRN on Qwen2.5-7B, use
# `{"rope_type":"yarn","factor":4.0,"original_max_position_embeddings":32768}`
# — but you must also raise VLLM_GPU_UTIL to 0.90 and stop GPU TEI first.
VLLM_ROPE_SCALING=

# Reasoning trace parser. Set to `qwen3` / `deepseek_r1` for those families
# so <think> blocks land in message.reasoning_content, not message.content.
# Leave blank for non-reasoning models.
VLLM_REASONING_PARSER=

# ----- Kev (decision model, time-shared with vLLM) ------------------------
# Pre-built image on this box: `cd kev && sudo ./build-kev-image.sh`.
# Weights (adapter + Qwen3.5-4B-Base @ 1001bb4d) are baked in — no HF access
# at runtime. bf16 is not optional on 16 GB (fp32 needs 16 GB for weights alone).
KEV_IMAGE=kev-serve:local
# KEV_DTYPE=bf16                  # default; fp32 for eval-path (won't fit)
# KEV_TEMPERATURE=                # blank = adapter-pinned default (see runbook)
# KEV_API_KEY=                    # set to enable bearer auth on /v1/*
# KEV_PREFIX_CACHE=               # see upstream kev README for cache knobs

# ----- TEI embedder (GPU) -------------------------------------------------
# CUDA image. ~1.3 GB VRAM steady, peaks ~0.5 GB extra on batches up to
# TEI_MAX_BATCH_TOKENS. 128K-token payload pipelines into ⌈128K/batch⌉
# forward passes.
TEI_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.5
TEI_MAX_BATCH_TOKENS=32768

# ----- TEI reranker (CPU) -------------------------------------------------
# CPU image by default — rerank pairs are short (≤512 tokens), CPU latency is
# ~100-200 ms per 20-pair batch (acceptable), and keeping it off GPU leaves
# the full card for the LLM (kev needs ~12 GB with CUDA Graphs). To put
# the reranker on GPU, set this to the CUDA tag AND re-add `<<: *gpu` in
# compose.inference.yml AND ensure the LLM has >5 GB headroom to give up.
TEI_RERANKER_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.5
TEI_RERANKER_MAX_BATCH_TOKENS=16384

# Max concurrent requests per TEI service (applies to both).
TEI_MAX_CONCURRENT=4
# Basename of a directory under $ARCHIVE_ROOT/models/local — that's where
# hf-curl-download.sh writes (e.g. `./hf-curl-download.sh BAAI/bge-m3`
# leaves it at /archive/models/local/bge-m3). Compose mounts that dir at
# /local-models inside the container and prepends the path. No HF round-trip
# at startup, so corp-proxy stalls don't crash-loop TEI.
TEI_MODEL=bge-m3

# ----- TEI (reranker) -----------------------------------------------------
# Same basename convention as TEI_MODEL above. CPU is fine — bge-reranker-large
# is ~568M params, 50-150ms/query on CPU. Avoid bge-reranker-v2-m3 (no ONNX) and
# jina-reranker-v2-base-multilingual (no model_type) — neither loads in TEI.
TEI_RERANKER_MODEL=bge-reranker-large

# ----- HuggingFace --------------------------------------------------------
# Read token from https://huggingface.co/settings/tokens — needed for gated
# models (Llama, Mistral). Public Qwen / BGE work without a token.
HF_TOKEN=

# ----- Claude Code usage observability ------------------------------------
# Lives in claude-usage/ as a standalone stack with its own .env
# (GRAFANA_PASSWORD, PROM_RETENTION, ...). When co-hosted here, set in
# claude-usage/.env:  GRAFANA_ROOT_URL=https://$SITE_HOST/grafana/  GRAFANA_SUB_PATH=true
# so Caddy's /grafana/ route works. See claude-usage/README.md.

# ----- Logging ------------------------------------------------------------
LOG_LEVEL=INFO
