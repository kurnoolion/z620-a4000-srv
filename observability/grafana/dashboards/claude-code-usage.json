      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Per-user breakdown (selected range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost_usd"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "total_tokens",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "input",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_token_usage{user_email=~\"$user\", type=\"input\"}[$__range]))"
        },
        {
          "refId": "output",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_token_usage{user_email=~\"$user\", type=\"output\"}[$__range]))"
        },
        {
          "refId": "cacheRead",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_token_usage{user_email=~\"$user\", type=\"cacheRead\"}[$__range]))"
        },
        {
          "refId": "cacheCreation",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_token_usage{user_email=~\"$user\", type=\"cacheCreation\"}[$__range]))"
        },
        {
          "refId": "total_tokens",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_token_usage{user_email=~\"$user\"}[$__range]))"
        },
        {
          "refId": "cost_usd",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table",
          "instant": true,
          "expr": "sum by (user_email) (increase(claude_code_cost_usage{user_email=~\"$user\"}[$__range]))"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "user_email",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true
            },
            "renameByName": {
              "Value #input": "input",
              "Value #output": "output",
              "Value #cacheRead": "cacheRead",
              "Value #cacheCreation": "cacheCreation",
              "Value #total_tokens": "total_tokens",
              "Value #cost_usd": "cost_usd"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Opus / Fable tokens per hour, by user  (granted-model audit)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        }
      },
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (user_email, model) (increase(claude_code_token_usage{user_email=~\"$user\", model=~\".*(opus|fable).*\"}[1h]))",
          "legendFormat": "{{user_email}} \u00b7 {{model}}"
        }
      ]
